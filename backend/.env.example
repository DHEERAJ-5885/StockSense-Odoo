# Copy to .env (never commit .env). The service-role key bypasses row-level security: keep it on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PORT=5000

# Email (Nodemailer). Leave SMTP_HOST empty to only print emails in this console (nothing is sent).
# Gmail: host smtp.gmail.com, port 465, user = your Gmail address, pass = a Google "App Password" (needs 2-step verification).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <your-address@example.com>

# Optional: fixed secret for hashing reset codes (a random one is used per start if empty)
RESET_SECRET=
